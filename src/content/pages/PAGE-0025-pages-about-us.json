  "contentBlocks": [
    {
      "blockOrder": 1,
      "blockType": "Paragraph",
      "title": "",
      "text": "您好！",
      "imageSource": "",
      "status": "已備份"
    },
    {
      "blockOrder": 2,
      "blockType": "Paragraph",
      "title": "",
      "text": "目前的購物車是空的！",
      "imageSource": "",
      "status": "已備份"
    },
    {
      "blockOrder": 3,
      "blockType": "Paragraph",
      "title": "",
      "text": "歡迎來到 VELORIA &mdash; 專屬於您的鑽石美學空間。",
      "imageSource": "",
      "status": "已備份"
    },
    {
      "blockOrder": 4,
      "blockType": "Paragraph",
      "title": "",
      "text": "VELORIA的品牌誕生於對永恆之美的熱愛與對匠心工藝的追求。從創立之初，致力於為每位顧客提供不僅是珠寶，更是一份珍貴的情感象徵。每一顆鑽石都承載著愛與承諾，希望透過精湛的設計與卓越的品質，讓每一份珠寶都能成為人生中閃耀的見證。",
      "imageSource": "",
      "status": "已備份"
    },
    {
      "blockOrder": 5,
      "blockType": "Paragraph",
      "title": "",
      "text": "📍 台北旗艦門市：敦化南路一段160巷11號",
      "imageSource": "",
      "status": "已備份"
    },
    {
      "blockOrder": 6,
      "blockType": "Paragraph",
      "title": "",
      "text": "捷運轉乘 台北捷運板南線 忠孝敦化站：8號出口出站後，沿敦化南路一段直行，步行約3分鐘，右轉進入160巷即可抵達 台北捷運板南線 忠孝復興站：4號出口出站後，沿敦化南路一段往南步行，約5–6分鐘，左轉進入160巷即可抵達",
      "imageSource": "",
      "status": "已備份"
    },
    {
      "blockOrder": 7,
      "blockType": "Paragraph",
      "title": "",
      "text": "外縣市及駕車 市民大道 → 復興南路一段 → 右轉敦化南路一段 → 直行至160巷 → 右轉進入160巷 → 抵達",
      "imageSource": "",
      "status": "已備份"
    },
    {
      "blockOrder": 8,
      "blockType": "Paragraph",
      "title": "",
      "text": "附近停車場建議： 嘟嘟房敦南站、城市車旅敦南站、忠孝敦化停車場",
      "imageSource": "",
      "status": "已備份"
    },
    {
      "blockOrder": 9,
      "blockType": "Paragraph",
      "title": "",
      "text": "⏰ 營業時間：11:00 - 19:00 ( 店休周日 )",
      "imageSource": "",
      "status": "已備份"
    },
    {
      "blockOrder": 10,
      "blockType": "Paragraph",
      "title": "",
      "text": "💬 線上客服不打烊，歡迎隨時聯繫我們",
      "imageSource": "",
      "status": "已備份"
    },
    {
      "blockOrder": 11,
      "blockType": "Paragraph",
      "title": "",
      "text": "Email： zuanzhiyun60@gmail.com",
      "imageSource": "",
      "status": "已備份"
    },
    {
