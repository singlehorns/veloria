---
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'knowledge'>;
}

const { article } = Astro.props;
const data = article.data;
const slug = article.slug;
const dateFormatter = new Intl.DateTimeFormat('zh-TW', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<article class="knowledge-article-card">
  <a href={`/blogs/diamond-symphony-guide/${slug}/`}>
    <div class="card-body">
      <h3>{data.title}</h3>
      <p>{data.description}</p>
      <time datetime={data.publishDate.toISOString()}>{dateFormatter.format(data.publishDate).replaceAll('/', '-')}</time>
    </div>
    <img src={data.coverImage} alt={data.coverImageAlt} width="450" height="450" loading="lazy" />
  </a>
</article>

<style>
  .knowledge-article-card {
    border-bottom: 1px solid rgba(183, 155, 112, 0.32);
  }

  .knowledge-article-card a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 360px);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding: 0 0 clamp(3rem, 6vw, 5rem);
  }

  .knowledge-article-card img {
    width: 100%;
    max-width: 360px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 0;
    background: #f4f3f0;
    filter: saturate(0.92);
  }

  .card-body {
    display: grid;
    align-content: start;
    gap: 1rem;
    max-width: 680px;
    min-height: 0;
  }

  h3 {
    margin: 0;
    color: #2f2b28;
    font-family: "Noto Serif TC", var(--font-serif), serif;
    font-size: clamp(1.45rem, 2vw, 2rem);
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0.04em;
  }

  p {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: rgba(47, 43, 40, 0.68);
    font-size: clamp(0.96rem, 1.05vw, 1.04rem);
    line-height: 1.9;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }

  time {
    display: grid;
    gap: 0.85rem;
    width: max-content;
    color: #0a3764;
    font-family: "GFS Didot", Didot, "Times New Roman", serif;
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    line-height: 1;
  }

  time::after {
    content: "";
    width: 72px;
    height: 1px;
    background: rgba(183, 155, 112, 0.58);
  }

  @media (max-width: 1180px) {
    .knowledge-article-card a {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 38vw);
      gap: var(--space-6);
    }
  }

  @media (max-width: 760px) {
    .knowledge-article-card a {
      grid-template-columns: 1fr;
      gap: var(--space-5);
      padding-bottom: var(--space-7);
    }

    .card-body {
      order: 2;
      min-height: auto;
    }

    .knowledge-article-card img {
      order: 1;
      max-width: none;
    }
  }
</style>
