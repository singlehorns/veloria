---
import type { CollectionEntry } from 'astro:content';
import { knowledgeCategories, type KnowledgeCategory } from '@data/knowledgeCategories';

interface Props {
  activeCategory?: string;
  activeArticleSlug?: string;
  articles?: CollectionEntry<'knowledge'>[];
  counts?: Record<string, number>;
  categories?: KnowledgeCategory[];
}

const { activeCategory, activeArticleSlug, articles = [], counts = {}, categories = knowledgeCategories } = Astro.props;
const articlesByCategory = new Map<string, CollectionEntry<'knowledge'>[]>();

for (const article of articles) {
  const groupedArticles = articlesByCategory.get(article.data.category) ?? [];
  groupedArticles.push(article);
  articlesByCategory.set(article.data.category, groupedArticles);
}
---

<aside class="knowledge-sidebar" aria-label="知識分類">
  <h1>知識分類</h1>
  <div class="sidebar-groups">
    {categories.map((category) => {
      const categoryArticles = articlesByCategory.get(category.slug) ?? [];

      return (
        <details
          class:list={['sidebar-group', { active: activeCategory === category.slug }]}
          open={activeCategory === category.slug}
          data-sidebar-group
        >
          <summary
            class:list={['sidebar-row', { active: activeCategory === category.slug, inactive: category.status !== 'active' }]}
          >
            <span>{category.name}</span>
            <strong>({counts[category.slug] ?? 0})</strong>
          </summary>
          {categoryArticles.length > 0 && (
            <div class="sidebar-articles" aria-label={`${category.name} 文章列表`}>
              {categoryArticles.map((article) => (
                <a
                  class:list={['sidebar-article-link', { active: activeArticleSlug === article.slug }]}
                  href={`/blogs/diamond-symphony-guide/${article.slug}/`}
                >
                  {article.data.title}
                </a>
              ))}
            </div>
          )}
        </details>
      );
    })}
  </div>
</aside>

<script>
  const knowledgeSidebars = document.querySelectorAll('.knowledge-sidebar');

  knowledgeSidebars.forEach((sidebar) => {
    const groups = Array.from(sidebar.querySelectorAll('details[data-sidebar-group]'));

    groups.forEach((group) => {
      group.addEventListener('toggle', () => {
        if (!(group instanceof HTMLDetailsElement) || !group.open) return;

        groups.forEach((other) => {
          if (other !== group && other instanceof HTMLDetailsElement) {
            other.open = false;
          }
        });
      });
    });
  });
</script>

<style>
  .knowledge-sidebar {
    position: sticky;
    top: calc(94px + 3rem);
    display: grid;
    align-content: start;
    border-top: 1px solid rgba(10, 55, 100, 0.24);
    color: #2f2b28;
    padding-top: 0.95rem;
  }

  .knowledge-sidebar h1 {
    display: flex;
    align-items: center;
    gap: 0.72rem;
    margin: 0 0 1rem;
    color: rgba(47, 43, 40, 0.48);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    line-height: 1;
    text-transform: uppercase;
  }

  .knowledge-sidebar h1::after {
    content: "";
    height: 1px;
    min-width: 34px;
    flex: 1;
    max-width: 84px;
    margin-top: 1px;
    background: rgba(10, 55, 100, 0.22);
  }

  .knowledge-sidebar h1::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: rgba(10, 55, 100, 0.48);
  }

  .sidebar-groups {
    display: grid;
    gap: 0;
  }

  .sidebar-row {
    display: flex;
    align-items: baseline;
    justify-content: flex-start;
    min-height: 46px;
    width: 100%;
    gap: 0.25rem;
    padding: 0;
    color: rgba(47, 43, 40, 0.7);
    cursor: pointer;
    font-size: clamp(1rem, 1.02vw, 1.1rem);
    font-weight: 500;
    line-height: 1.32;
    list-style: none;
    transition:
      color 180ms ease;
  }

  .sidebar-row::-webkit-details-marker {
    display: none;
  }

  .sidebar-row:focus {
    outline: none;
  }

  .sidebar-row:focus-visible {
    color: #0a3764;
  }

  .sidebar-group {
    border-bottom: 1px solid rgba(10, 55, 100, 0.09);
  }

  .sidebar-group .sidebar-row {
    width: 100%;
    border-bottom: 0;
  }

  .sidebar-row::after {
    content: "+";
    margin-left: auto;
    color: rgba(10, 55, 100, 0.52);
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1;
    transition:
      color 180ms ease,
      transform 220ms ease;
  }

  .sidebar-group[open] .sidebar-row::after {
    content: "-";
    color: #0a3764;
    transform: rotate(180deg);
  }

  .sidebar-row strong {
    color: rgba(47, 43, 40, 0.42);
    font-size: 0.86em;
    font-weight: 400;
  }

  .sidebar-row:hover {
    color: #0a3764;
  }

  .sidebar-row.active {
    color: #0a3764;
  }

  .sidebar-row.inactive {
    color: rgba(47, 43, 40, 0.36);
  }

  .sidebar-articles {
    display: grid;
    gap: 0;
    padding: 0.14rem 0 0.9rem 0.72rem;
    animation: sidebarArticlesReveal 260ms ease both;
    transform-origin: top;
  }

  .sidebar-article-link {
    position: relative;
    display: block;
    padding: 0.54rem 0 0.54rem 0.9rem;
    border-bottom: 1px solid rgba(10, 55, 100, 0.07);
    color: rgba(47, 43, 40, 0.62);
    font-size: clamp(11px, 0.78vw, 13px);
    font-weight: 400;
    line-height: 1.55;
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .sidebar-article-link::before {
    content: "";
    position: absolute;
    top: 1.04rem;
    left: 0;
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: rgba(10, 55, 100, 0.42);
    transition:
      background 180ms ease,
      transform 180ms ease;
  }

  .sidebar-article-link:last-child {
    border-bottom: 0;
  }

  .sidebar-article-link:hover,
  .sidebar-article-link.active {
    color: #0a3764;
  }

  .sidebar-article-link:hover {
    transform: translateX(3px);
  }

  .sidebar-article-link.active {
    font-weight: 500;
  }

  .sidebar-article-link.active::before {
    background: #0a3764;
    transform: scale(1.35);
  }

  @keyframes sidebarArticlesReveal {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1023px) {
    .knowledge-sidebar {
      position: static;
      border: 1px solid rgba(10, 55, 100, 0.2);
      padding: var(--space-4);
      background: #ffffff;
    }
  }
</style>
