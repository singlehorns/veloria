---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="knowledge-breadcrumbs" aria-label="Breadcrumb">
  {items.map((item, index) => (
    <>
      {item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
      {index < items.length - 1 && <span aria-hidden="true">/</span>}
    </>
  ))}
</nav>

<style>
  .knowledge-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: clamp(10px, 1.5vw, 18px) 0 clamp(6px, 1.4vw, 18px);
    color: rgba(21, 18, 15, 0.34);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.04em;
  }

  .knowledge-breadcrumbs a {
    color: inherit;
  }
</style>
