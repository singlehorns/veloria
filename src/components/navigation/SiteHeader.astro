    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scaleY(1);
    transition:
      opacity 360ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 620ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s;
