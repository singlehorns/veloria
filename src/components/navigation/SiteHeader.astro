  .mega-item.is-open .mega-children {
    max-height: 360px;
    opacity: 1;
    transform: translateY(0);
    padding: 0 0 0.65rem;
  }

  .mega-children a {
    position: relative;
    padding: 0.32rem 0 0.32rem 0.9rem;
    color: #758198;
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .mega-children a::before {
