    gap: 0.55rem 1.3rem;
    align-content: start;
  }

  .mega-item {
    position: relative;
    border-bottom: 1px solid rgba(10, 55, 100, 0.14);
  }

  .mega-item > a,
  .mega-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    width: 100%;
    min-height: 48px;
    border: 0;
    padding: 0.72rem 0;
    background: transparent;
    color: #1d2840;
    font: inherit;
    font-size: 0.93rem;
    font-weight: var(--type-weight-medium);
    letter-spacing: 0.05em;
    text-align: left;
    cursor: pointer;
    transition: color var(--motion-duration-fast) var(--motion-ease-standard);
  }

  .mega-trigger::after {
    content: "";
    width: 0.42rem;
    height: 0.42rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-20%) rotate(45deg);
    transition: transform var(--motion-duration-standard) var(--motion-ease-editorial);
  }

  .mega-item > a:hover,
  .mega-trigger:hover,
  .mega-trigger:focus-visible,
  .mega-item.is-open .mega-trigger {
