---
import { getCollection } from 'astro:content';
import { knowledgeLandingPath, navItems, site } from '@data/site';

const products = await getCollection('products');

const searchProducts = products.map((product) => {
  const data = product.data as any;
  const displayName = data.originalDisplayName || data.englishName || data.name || data.slug;
  const image = data.images?.[0];
  const searchText = [
    data.name,
    data.englishName,
    data.originalDisplayName,
    data.slug,
    data.category,
    data.collection,
    data.productType,
    data.audience,
    data.diamondType,
    ...(data.tags ?? []),
    ...(data.collections ?? []),
    ...(data.collectionSlugs ?? [])
  ]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();

  return {
    displayName,
    href: `/products/${data.slug}/`,
    price: data.displayPrice || data.price || data.salePrice || '歡迎洽詢',
    image: image?.src,
    imageAlt: image?.alt || displayName,
    searchText
  };
});

const overlayCategories = [
  {
    label: '求婚戒指',
    href: '/categories/womens-diamond-rings/engagement-rings/',
    image: '/assets/migrated/collections/proposal-ring.jpeg'
