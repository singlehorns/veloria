---

<header class="site-header" data-site-header>
  <div class="brand-strip" aria-label="品牌提示">
    <span>求婚鑽戒、結婚對戒、天然鑽石與彩色鑽石｜DIAMOND SYMPHONY</span>
  </div>

  <div class="header-main">
    <a class="brand" href="/" aria-label="Veloria 首頁">
      <img class="brand-logo brand-logo-default" src="/assets/brand/veloria-wordmark.svg" alt="Veloria" width="150" height="43" />
      <img class="brand-logo brand-logo-inverse" src="/assets/brand/veloria-wordmark-white.svg" alt="" width="150" height="43" aria-hidden="true" />
      <span>{site.name}</span>
    </a>

    <nav class="desktop-nav" aria-label="主選單">
      {navItems.map((item) => (
        item.children ? (
          <div class="nav-group">
            <a class="nav-link" href={item.href}>{item.label}</a>
            <div class="mega-menu" aria-label={`${item.label}子選單`}>
              <div class="mega-inner">
                <div class="mega-list">
                  {item.children.map((child) => (
                    <div class:list={['mega-item', { 'has-children': child.children }]}>
                      {child.children ? (
                        <button class="mega-trigger" type="button" aria-expanded="false" data-mega-trigger>{child.label}</button>
                      ) : (
                        <a href={child.href}>{child.label}</a>
                      )}
                      {child.children && (
                        <div class="mega-children">
                          {child.children.map((grandchild) => <a href={grandchild.href}>{grandchild.label}</a>)}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ) : (
          <a class="nav-link" href={item.href}>{item.label}</a>
        )
      ))}
    </nav>

    <div class="header-actions">
      <form class="site-search" action="/search/" method="get" role="search" data-site-search>
        <label class="site-search-field">
          <span class="utility-icon" aria-hidden="true"></span>
          <input type="search" name="q" placeholder="搜尋商品" autocomplete="off" aria-label="搜尋商品" data-site-search-input />
        </label>
        <div class="site-search-panel" data-site-search-panel>
          <p data-site-search-summary>輸入關鍵字搜尋商品</p>
          <div class="site-search-results">
            {searchProducts.map((product) => (
              <a class="site-search-result" href={product.href} data-site-search-result data-search-text={product.searchText} hidden>
                <figure>
                  {product.image ? (
                    <img src={product.image} alt={product.imageAlt} loading="lazy" />
                  ) : (
                    <span>VELORIA</span>
                  )}
                </figure>
                <span>
                  <strong>{product.displayName}</strong>
                  <small>{product.price}</small>
                </span>
              </a>
            ))}
          </div>
          <a class="site-search-more" href="/search/" data-site-search-more hidden>查看全部搜尋結果</a>
        </div>
      </form>
      <a class="utility-link" href={site.reservationUrl} target="_blank" rel="noopener noreferrer" aria-label="預約諮詢">
        <span class="utility-icon reserve" aria-hidden="true"></span>
        <strong>預約</strong>
      </a>
      <button class="menu-toggle" type="button" aria-label="開啟選單" aria-controls="mobile-nav" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="行動版選單">
    <div class="overlay-inner">
      <section class="overlay-category" aria-labelledby="overlay-category-heading">
        <h2 id="overlay-category-heading">CATEGORY</h2>
        <div class="overlay-card-grid">
          {overlayCategories.map((category) => (
            <a class="overlay-card" href={category.href}>
              <figure>
                <img src={category.image} alt={category.label} loading="lazy" />
              </figure>
              <span>{category.label}</span>
            </a>
          ))}
        </div>
      </section>

      <div class="overlay-links" aria-label="主要導覽連結">
        {menuOverlayColumns.map((column) => (
          <section class="overlay-column">
            <h2>{column.title}</h2>
            <ul>
              {column.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <aside class="overlay-aside" aria-label="快速連結">
        <div class="overlay-contact">
          <a class="overlay-reserve" href={site.reservationUrl} target="_blank" rel="noopener noreferrer">
            <span class="utility-icon reserve" aria-hidden="true"></span>
            <strong>預約諮詢</strong>
          </a>
          <h2>聯絡資訊</h2>
          <dl>
            <div>
              <dt>電話</dt>
              <dd>02-27791005</dd>
            </div>
            <div>
              <dt>營業時間</dt>
              <dd>11:00 ~ 19:00 (店休週日)</dd>
            </div>
            <div>
              <dt>EMAIL</dt>
              <dd><a href="mailto:zuanzhiyun60@gmail.com">zuanzhiyun60@gmail.com</a></dd>
            </div>
            <div>
              <dt>地址</dt>
              <dd>台北旗艦門市-敦化南路一段 160 巷 11 號</dd>
            </div>
            <div>
              <dt>統一編號</dt>
              <dd>00243191</dd>
            </div>
          </dl>
        </div>
        <div class="overlay-social">
          <span>FOLLOW US ON</span>
          <a href={site.facebookUrl} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <i aria-hidden="true">f</i>
            <strong>FACEBOOK</strong>
          </a>
          <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <i aria-hidden="true">◎</i>
            <strong>INSTAGRAM</strong>
          </a>
          <a href={site.lineUrl} target="_blank" rel="noopener noreferrer" aria-label="LINE 專人諮詢">
            <i aria-hidden="true">LINE</i>
            <strong>LINE 專人諮詢</strong>
          </a>
        </div>
      </aside>
    </div>
  </nav>
</header>
<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('.mobile-nav');
  const siteSearch = document.querySelector<HTMLElement>('[data-site-search]');
  const siteSearchInput = document.querySelector<HTMLInputElement>('[data-site-search-input]');
  const siteSearchSummary = document.querySelector<HTMLElement>('[data-site-search-summary]');
  const siteSearchMore = document.querySelector<HTMLAnchorElement>('[data-site-search-more]');
  const siteSearchResults = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-site-search-result]'));

  const normalizeSearchQuery = (value: string) => value.trim().toLowerCase();

  const updateSiteSearchPreview = () => {
    const query = siteSearchInput?.value.trim() || '';
    const normalizedQuery = normalizeSearchQuery(query);
    const terms = normalizedQuery.split(/\s+/).filter(Boolean);
    let matchCount = 0;
    let visibleCount = 0;

    siteSearchResults.forEach((result) => {
      const haystack = result.dataset.searchText || '';
      const isMatch = terms.length > 0 && terms.every((term) => haystack.includes(term));
      if (isMatch) matchCount += 1;
      result.hidden = !isMatch || visibleCount >= 4;
      if (isMatch && visibleCount < 4) visibleCount += 1;
    });

    siteSearch?.classList.toggle('has-query', terms.length > 0);
    siteSearch?.classList.toggle('has-preview-results', matchCount > 0);

    if (siteSearchSummary) {
      siteSearchSummary.textContent = terms.length
        ? matchCount > 0
          ? `找到 ${matchCount} 件相關商品`
          : '找不到你要的商品'
        : '輸入關鍵字搜尋商品';
    }

    if (siteSearchMore) {
      siteSearchMore.hidden = terms.length === 0;
      siteSearchMore.href = terms.length ? `/search/?q=${encodeURIComponent(query)}` : '/search/';
    }
  };

  siteSearchInput?.addEventListener('input', () => {
    siteSearch?.classList.add('is-open');
    updateSiteSearchPreview();
  });
  siteSearchInput?.addEventListener('pointerdown', () => {
    if (document.activeElement !== siteSearchInput) return;
    if (siteSearchInput.value.trim()) return;
    if (siteSearch?.classList.contains('is-open')) {
      siteSearch.classList.remove('is-open');
      window.requestAnimationFrame(() => siteSearchInput.blur());
      return;
    }
    siteSearch?.classList.add('is-open');
  });
  siteSearchInput?.addEventListener('focus', () => {
    siteSearch?.classList.add('is-open');
    updateSiteSearchPreview();
  });

  siteSearch?.addEventListener('submit', (event) => {
    const query = siteSearchInput?.value.trim() || '';
    if (!query) {
      event.preventDefault();
      return;
    }
  });

  const setMenuOpen = (open: boolean) => {
    button?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('is-open', open);
    header?.classList.toggle('has-open-menu', open);
    document.documentElement.classList.toggle('has-site-menu', open);
  };

  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    setMenuOpen(!open);
  });

  const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
  document.querySelectorAll<HTMLAnchorElement>('.desktop-nav a, .mobile-nav a').forEach((link) => {
    const linkPath = new URL(link.href, window.location.origin).pathname.replace(/\/$/, '') || '/';
    if (linkPath === currentPath) {
      link.setAttribute('aria-current', 'page');
    }
  });

  document.querySelectorAll<HTMLElement>('.mega-menu').forEach((menu) => {
    const closeItems = (except?: Element) => {
      menu.querySelectorAll<HTMLElement>('.mega-item.is-open').forEach((item) => {
        if (item === except) return;
        item.classList.remove('is-open');
        item.querySelector<HTMLButtonElement>('[data-mega-trigger]')?.setAttribute('aria-expanded', 'false');
      });
    };

    menu.querySelectorAll<HTMLButtonElement>('[data-mega-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const item = trigger.closest<HTMLElement>('.mega-item');
        if (!item) return;

        const willOpen = !item.classList.contains('is-open');
        closeItems(item);
        item.classList.toggle('is-open', willOpen);
        trigger.setAttribute('aria-expanded', String(willOpen));
      });
    });

    menu.addEventListener('mouseleave', () => closeItems());
  });

  document.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('.desktop-nav')) return;
    if (event.target instanceof Element && event.target.closest('[data-site-search]')) return;
    if (event.target instanceof Element && event.target.closest('.menu-toggle, .mobile-nav')) return;

    siteSearch?.classList.remove('is-open');
    document.querySelectorAll<HTMLElement>('.mega-item.is-open').forEach((item) => {
      item.classList.remove('is-open');
      item.querySelector<HTMLButtonElement>('[data-mega-trigger]')?.setAttribute('aria-expanded', 'false');
    });
    setMenuOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      siteSearch?.classList.remove('is-open');
      setMenuOpen(false);
    }
  });

  nav?.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  let lastScrollY = window.scrollY;
  let ticking = false;

  const updateHeaderState = () => {
    const currentScrollY = window.scrollY;
    const isScrollingDown = currentScrollY > lastScrollY + 6;
    const isScrollingUp = currentScrollY < lastScrollY - 6;
    const menuOpen = button?.getAttribute('aria-expanded') === 'true';

    header?.classList.toggle('is-scrolled', currentScrollY > 24);

    if (!menuOpen && isScrollingDown && currentScrollY > 260) {
      header?.classList.add('is-hidden');
    }

    if (isScrollingUp || currentScrollY <= 80 || menuOpen) {
      header?.classList.remove('is-hidden');
    }

    lastScrollY = currentScrollY;
    ticking = false;
  };

  window.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    window.requestAnimationFrame(updateHeaderState);
  }, { passive: true });
</script>

<style>
  .site-header {
    --site-header-main-height: 56px;
    position: sticky;
    top: 0;
    z-index: 40;
    background: #fff;
    color: var(--color-brand-pink-deep);
    box-shadow: 0 1px 0 rgba(10, 55, 100, 0.16);
    transform: none;
    transition:
      transform var(--motion-duration-standard) var(--motion-ease-editorial),
      box-shadow var(--motion-duration-standard) var(--motion-ease-standard);
  }

  :global(html.has-site-menu) {
    overflow: hidden;
  }

  .site-header.is-scrolled {
    box-shadow: 0 18px 34px rgba(10, 55, 100, 0.12);
  }

  .site-header.is-hidden:not(.has-open-menu) {
    transform: translateY(-100%);
  }

  .site-header.has-open-menu {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    width: 100%;
    transform: none;
    background: var(--color-brand-pink-deep);
  }

  .brand-strip {
    display: none;
    place-items: center;
    min-height: 0;
    padding: 0;
    background: var(--color-brand-pink-deep);
    color: #fff;
    font-family: var(--font-editorial-serif);
    font-size: 0.78rem;
    font-weight: var(--type-weight-medium);
    letter-spacing: 0.08em;
    text-align: center;
  }

  .site-header.has-open-menu .brand-strip,
  .site-header.has-open-menu .header-main {
    background: var(--color-brand-pink-deep);
    border-color: rgba(255, 255, 255, 0.16);
    box-shadow: none;
  }

  .site-header.has-open-menu .header-main {
    width: min(100% - clamp(78px, 8vw, 150px), 1420px);
    max-width: 1420px;
    transform: translateX(clamp(18px, 1.5vw, 30px));
  }

  .header-main {
    position: relative;
    z-index: 51;
    display: flex;
    justify-content: center;
    align-items: center;
    width: min(calc(100% - clamp(32px, 7vw, 128px)), 1120px);
    max-width: 1120px;
    min-height: 56px;
    margin-inline: auto;
    padding: 0;
    border-bottom: 1px solid rgba(10, 55, 100, 0.16);
    background: rgba(255, 255, 255, 0.98);
    transition:
      background-color var(--motion-duration-standard) var(--motion-ease-standard),
      border-color var(--motion-duration-standard) var(--motion-ease-standard);
  }

  .brand {
    position: absolute;
    left: 0;
    top: 50%;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    width: max-content;
    min-width: 0;
    transform: translateY(-50%);
    color: var(--color-brand-pink-deep);
    transition:
      color var(--motion-duration-standard) var(--motion-ease-standard),
      opacity var(--motion-duration-fast) var(--motion-ease-standard);
  }

  .site-header.has-open-menu .brand {
    color: #fff;
  }

  .brand:hover,
  .brand:focus-visible {
    opacity: 0.72;
  }

  .brand img {
    width: clamp(124px, 8vw, 150px);
    max-height: 42px;
    height: auto;
    object-fit: contain;
  }

  .brand-logo {
    transition: opacity var(--motion-duration-standard) var(--motion-ease-standard);
  }

  .brand-logo-inverse {
    position: absolute;
    left: 0;
    top: 50%;
    opacity: 0;
    transform: translateY(-50%);
  }

  .site-header.has-open-menu .brand-logo-default {
    opacity: 0;
  }

  .site-header.has-open-menu .brand-logo-inverse {
    opacity: 1;
  }

  .brand span {
    display: none;
    margin-left: 0.75rem;
    font-family: var(--font-editorial-serif);
    font-size: clamp(0.98rem, 0.42vw + 0.86rem, 1.2rem);
    font-weight: var(--type-weight-medium);
    letter-spacing: 0.05em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .desktop-nav {
    position: absolute;
    top: 0;
    bottom: 0;
    left: clamp(158px, 10vw, 176px);
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: nowrap;
    width: max-content;
    max-width: calc(100vw - 520px);
    gap: clamp(0.05rem, 0.32vw, 0.46rem);
    min-width: 0;
    height: 56px;
    margin-inline: 0;
    margin-block: auto;
    font-family: var(--font-functional-sans);
    font-size: 0.864rem;
    font-weight: var(--type-weight-medium);
    letter-spacing: 0.06em;
    overflow: visible;
  }

  .site-header.has-open-menu .desktop-nav,
  .site-header.has-open-menu .site-search,
  .site-header.has-open-menu .utility-link {
    opacity: 0;
    pointer-events: none;
  }

  .nav-group,
  .desktop-nav > .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    height: 56px;
  }

  .nav-link,
  .nav-group > .nav-link {
