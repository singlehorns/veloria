  .collection-scroll-ring {
    --scroll-progress: 0;
    position: absolute;
    top: clamp(36px, 5.2vw, 86px);
    left: max(-112px, calc((100vw - 1180px) / 2 - 184px));
    z-index: 1;
    width: clamp(378px, 32vw, 640px);
    height: clamp(268px, 22.7vw, 446px);
    pointer-events: none;
    opacity: calc(0.68 + (var(--scroll-progress) * 0.2));
    transform:
      translate3d(
        calc(82px * var(--scroll-progress)),
        calc(-54px * var(--scroll-progress)),
        0
      )
      rotate(calc(-14deg + (26deg * var(--scroll-progress))))
      scale(calc(0.94 + (0.16 * var(--scroll-progress))));
    transition:
      opacity 180ms linear,
      transform 160ms linear;
  }

  .collection-scroll-ring img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter:
      brightness(0.96)
      contrast(1.12)
      saturate(1.14)
      drop-shadow(0 20px 28px rgba(16, 32, 48, 0.18));
  }

  .collection-scroll-jewel {
    --scroll-progress: 0;
    position: absolute;
    top: clamp(-96px, -5vw, -58px);
    right: max(-120px, calc((100vw - 1180px) / 2 - 210px));
    z-index: 1;
    width: clamp(280px, 27vw, 470px);
    height: clamp(170px, 17vw, 285px);
    pointer-events: none;
    opacity: calc(0.62 + (var(--scroll-progress) * 0.26));
    transition: opacity 180ms linear;
  }

  .collection-scroll-jewel::after {
    content: "";
    position: absolute;
    left: 6%;
    right: 0;
    bottom: 8%;
    height: 26%;
    border-radius: 999px;
    background: radial-gradient(ellipse at center, rgba(15, 26, 38, 0.08), rgba(15, 26, 38, 0) 68%);
    transform: scaleX(calc(0.8 + (var(--scroll-progress) * 0.16)));
  }

  .loose-diamond-piece {
    position: absolute;
    width: var(--diamond-size);
    height: var(--diamond-size);
    object-fit: contain;
    opacity: var(--diamond-opacity, 0.96);
    filter:
      contrast(1.16)
      saturate(1.08)
      drop-shadow(0 16px 20px rgba(16, 32, 48, 0.16));
    transform:
      translate3d(
        calc(var(--move-x) * var(--scroll-progress)),
        calc(var(--move-y) * var(--scroll-progress)),
        0
      )
      rotate(calc(var(--rotate-start) + (var(--rotate-range) * var(--scroll-progress))))
      scale(calc(var(--scale-start) + (var(--scale-range) * var(--scroll-progress))));
    transition: transform 160ms linear;
  }

