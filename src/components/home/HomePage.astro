      radial-gradient(ellipse at 48% 46%, rgba(232, 216, 176, 0.2), rgba(232, 216, 176, 0) 60%),
      radial-gradient(ellipse at 72% 28%, rgba(192, 211, 222, 0.16), rgba(192, 211, 222, 0) 62%);
