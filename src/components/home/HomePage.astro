    --home-space-emphasis: clamp(72px, 8vw, 118px);
    --home-space-standard: clamp(58px, 6.5vw, 94px);
    --home-space-supporting: clamp(46px, 5vw, 72px);
    --home-grid-gap: clamp(1rem, 2.2vw, 2rem);
    --home-content-gap: clamp(0.8rem, 1.45vw, 1.25rem);
    --home-card-gap: clamp(0.85rem, 1.35vw, 1.25rem);
    --home-title-width: 18ch;
    --home-lead-width: 38em;
    --home-body-width: 46em;
  }

  @media (min-width: 1041px) {
    :global(:root) {
      --home-space-emphasis: clamp(58px, 6.4vw, 94px);
      --home-space-standard: clamp(46px, 5.2vw, 75px);
      --home-space-supporting: clamp(37px, 4vw, 58px);
      --home-grid-gap: clamp(0.8rem, 1.75vw, 1.6rem);
      --home-content-gap: clamp(0.64rem, 1.16vw, 1rem);
      --home-card-gap: clamp(0.68rem, 1.08vw, 1rem);
      --home-title-width: 17ch;
      --home-lead-width: 34em;
      --home-body-width: 40em;
    }
  }

  :global(body) {
    background: #ffffff;
  }

  .home-hero-title {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .home-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: clamp(620px, 76vh, 820px);
    padding-block: clamp(46px, 5.8vw, 72px) clamp(30px, 4vw, 48px);
    background:
      linear-gradient(90deg, #ffffff 0 82%, #f7f6f4 82% 100%);
  }

  .home-hero::before {
    content: "";
    position: absolute;
    top: 18%;
    right: clamp(18px, 2.7vw, 54px);
    width: clamp(160px, 17vw, 330px);
    height: clamp(300px, 38vw, 540px);
    border: 1px solid rgba(17, 17, 17, 0.055);
    border-radius: 52% 48% 44% 56% / 48% 44% 56% 52%;
    opacity: 0.65;
    transform: rotate(-18deg);
    pointer-events: none;
  }

  .home-hero::after {
    content: "";
    position: absolute;
    top: 35%;
    right: clamp(34px, 4vw, 82px);
    width: clamp(120px, 12vw, 230px);
    height: clamp(230px, 28vw, 390px);
    border: 1px solid rgba(17, 17, 17, 0.045);
    border-radius: 48% 52% 58% 42% / 50% 58% 42% 50%;
    opacity: 0.7;
    transform: rotate(18deg);
    pointer-events: none;
  }

  .hero-canvas {
    position: absolute;
    top: clamp(54px, 6.2vw, 86px);
    left: clamp(0px, 2vw, 36px);
    width: min(76vw, calc(100% - clamp(230px, 22vw, 430px)));
    height: clamp(470px, 64vh, 680px);
    margin: 0;
    overflow: hidden;
    background: #f7f2eb;
    box-shadow: 0 28px 72px rgba(17, 17, 17, 0.08);
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transform: scale(1.035);
    transition:
      opacity 980ms var(--motion-ease-standard),
      transform 1600ms var(--motion-ease-editorial);
  }

  .hero-slide.is-active {
    z-index: 1;
    opacity: 1;
    transform: scale(1);
  }

  .hero-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-preview {
    position: absolute;
    z-index: 2;
    top: clamp(148px, 17vw, 230px);
    right: clamp(52px, 5.8vw, 112px);
    width: clamp(150px, 16vw, 290px);
