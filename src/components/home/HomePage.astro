---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { site } from '@data/site';

interface Props {
  canonical?: string;
}

const { canonical = '/' } = Astro.props;

const products = await getCollection('products');
const productBySlug = new Map(
  products.map((product) => [product.data.slug, { ...product.data, routeSlug: product.data.slug }])
);

const knowledgeEntries = (await getCollection('knowledge'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const highlightedKnowledge = knowledgeEntries.filter((entry) => entry.data.featured);
const knowledgeCards = (highlightedKnowledge.length >= 4 ? highlightedKnowledge : knowledgeEntries).slice(0, 4);

const recommendationSlugs = [
  'trinity-eclat',
  'trilogy-vow',
  'union-light',
  'entwined-promise',
  'entwined-destiny',
  'golden-vow',
  'celestial-bloom',
  'steady-heartlight'
];

const recommendationProducts = recommendationSlugs
  .map((slug) => productBySlug.get(slug))
  .filter(Boolean);

const weddingRingSlugs = [
  'unity-knot',
  'harmonic-loop',
  'radiant-bond',
  'timeless-prelude',
  'echo-of-us',
  'bonded-edge',
  'silent-line'
];

const weddingRingProducts = weddingRingSlugs
  .map((slug) => productBySlug.get(slug))
  .filter(Boolean);

const heroSlides = [
  {
    image: '/assets/migrated/banners/home-hero-2.jpeg',
    eyebrow: 'Engagement Atelier',
    ghost: 'Soul',
    title: '讓承諾成為日常配戴的光',
    titleLines: ['讓承諾', '成為日常配戴的光'],
    lead: '從主鑽挑選、戒台比例到佩戴習慣，協助你找到適合求婚時刻與日常生活的鑽戒。',
    href: '/categories/womens-diamond-rings/engagement-rings/',
    cta: '探索求婚戒指'
  },
  {
    image: '/assets/migrated/banners/home-hero-3.jpeg',
    eyebrow: 'Colored Diamond',
    ghost: 'Color',
    title: '以色彩收藏獨一無二的心意',
    titleLines: ['以色彩收藏', '獨一無二的心意'],
    lead: '黃鑽、粉鑽、藍鑽與多色彩鑽作品，為重要紀念留下更鮮明的個人風格。',
    href: '/categories/colored-diamonds/',
    cta: '探索彩色鑽石'
  },
  {
    image: '/assets/migrated/banners/home-hero-1.jpeg',
    eyebrow: 'Taipei Flagship',
    ghost: 'Taipei',
    title: '在台北門市慢慢確認細節',
    titleLines: ['在台北門市', '慢慢確認細節'],
    lead: '預約一對一諮詢，由專人依照預算、證書、材質與佩戴情境整理合適方向。',
    href: site.reservationUrl,
    cta: '預約諮詢'
  }
];

const categoryCards = [
  {
    label: '求婚戒指',
    english: 'Engagement Rings',
    href: '/categories/womens-diamond-rings/engagement-rings/',
    image: '/assets/migrated/collections/proposal-ring.jpeg',
    hoverImage: '/assets/migrated/products/DSF0022-radiant-vow/localized/DSF0022-main-01.png'
  },
  {
    label: '結婚對戒',
    english: 'Wedding Bands',
    href: '/categories/other-jewelry/pair-rings/',
    image: '/assets/migrated/collections/wedding-ring.jpeg',
    hoverImage: '/assets/migrated/products/DSP-0017-unity-knot/localized/DSP-0017-main-01.png'
  },
  {
    label: '男士鑽戒',
    english: 'Modern Gent',
    href: '/categories/mens-diamond-rings/',
    image: '/assets/migrated/collections/mens-ring.jpeg',
    hoverImage: '/assets/migrated/products/DSP-0028-steady-heartlight/localized/DSP-0028-main-01.jpeg'
  },
  {
    label: '女士鑽戒',
    english: 'Women Collection',
    href: '/categories/womens-diamond-rings/',
    image: '/assets/migrated/collections/womens-ring.jpeg',
    hoverImage: '/assets/migrated/products/DSP-0002-trinity-eclat/localized/DSP-0002-main-01.jpeg'
  },
  {
    label: '時尚珠寶',
    english: 'Fine Jewelry',
    href: '/categories/other-jewelry/',
    image: '/assets/migrated/collections/necklace.jpeg',
    hoverImage: '/assets/migrated/products/DSP-0008-amour-de-c-ur/localized/DSP-0008-main-01.png'
  },
  {
    label: '精選裸鑽',
    english: 'Loose Diamonds',
    href: '/categories/loose-diamonds/',
    image: '/assets/migrated/collections/loose-diamond.jpeg',
    hoverImage: '/assets/migrated/products/DSL0005-round/localized/DSL0005-main-01.png'
  }
];

const brandMarqueeWords = Array.from({ length: 32 }, () => 'veloria');

const newsCards = [
  {
    label: 'Latest News',
    date: '2026.07.19 - 2026.08.31',
    title: '婚戒諮詢與訂製服務開放預約',
    description: '歡迎預約門市，由專人協助整理主鑽、戒台、材質與預算配置。',
    href: site.reservationUrl
  }
];

const serviceShowcaseScene = {
  image: '/assets/custom-service/service-showcase-01.png',
  alt: '鑽戒訂製與珠寶設計服務展示'
};

const serviceShowcaseSlides = [
  {
    label: 'Aurora Hoops',
    title: '極光圈影',
    description: '以細緻鑽光與日常比例呈現輕盈感，適合想要低調但有亮點的配戴風格。',
    cta: '查看商品',
    href: '/products/aurora-hoops/',
    image: '/assets/migrated/products/DSP-0078-aurora-hoops/localized/DSP-0078-main-01.png'
  },
  {
    label: 'Akatsuki Dance',
    title: '曉舞星光',
    description: '柔和線條與主石光芒交會，適合送禮、紀念或日常收藏。',
    cta: '查看商品',
    href: '/products/akatsuki-dance/',
    image: '/assets/migrated/products/DSP-0067-akatsuki-dance/localized/DSP-0067-main-01.png'
  },
  {
    label: 'Golden Bloom',
    title: '金色綻放',
    description: '溫潤金色與鑽石火光相互映襯，呈現明亮而優雅的彩鑽氣質。',
    cta: '查看商品',
    href: '/products/golden-bloom/',
    image: '/assets/migrated/products/DSP-0034-golden-bloom/localized/DSP-0034-main-01.png'
  },
  {
    label: 'Amour de Coeur',
    title: '心語之光',
    description: '心形輪廓承接浪漫寓意，適合重要紀念與真摯心意。',
    cta: '查看商品',
    href: '/products/amour-de-c-ur/',
    image: '/assets/migrated/products/DSP-0008-amour-de-c-ur/localized/DSP-0008-main-01.png'
  }
];

const homeFaqItems = [
  {
    question: '第一次挑選求婚鑽戒，要先看什麼？',
    answer: '建議先確認預算、配戴者的日常風格與希望的主鑽大小，再一起比較天然鑽石、培育鑽石、證書與戒台設計。'
  },
  {
    question: '天然鑽石和培育鑽石可以一起比較嗎？',
    answer: '可以。我們會依照預算、克拉數、顏色、淨度與證書需求，協助整理兩種選項的差異，讓選擇更清楚。'
  },
  {
    question: '可以客製化戒台或調整材質嗎？',
    answer: '可以依照主鑽條件、戒圍尺寸、金屬材質與線條比例討論，部分款式也能加入刻字或細節調整。'
  },
  {
    question: '需要預約才能到店諮詢嗎？',
    answer: '建議先預約，讓專人為您保留完整時間，並提前準備適合的鑽石、戒台與款式建議。'
  }
];

const productNameOverrides: Record<string, string> = {
  'trinity-eclat': '三序映華 | Trinity Eclat',
  'trilogy-vow': '三生之約 | Trilogy Vow',
  'union-light': '交會之光 | Union Light',
  'entwined-promise': '交織承諾 | Entwined Promise',
  'entwined-destiny': '交織命定 | Entwined Destiny',
  'golden-vow': '金色誓約 | Golden Vow',
  'celestial-bloom': '星瀾綻放 | Celestial Bloom',
  'steady-heartlight': '恆心之光 | Steady Heartlight',
  'sovereign-seal': '王者印記 | Sovereign Seal',
  'sovereign-glow': '王者光輝 | Sovereign Glow',
  'crown-of-majesty': '冠冕之光 | Crown of Majesty',
  'imperial-glory': '帝王榮光 | Imperial Glory',
  'regal-seal': '尊爵印記 | Regal Seal',
  'regal-frame': '尊爵框景 | Regal Frame',
  'stellar-dominion': '星域之境 | Stellar Dominion',
  'monolith-brilliance': '磐石光芒 | Monolith Brilliance',
  'aurora-path': '極光之徑 | Aurora Path',
  princess: '公主方鑽 | Princess',
  round: '圓形鑽 | Round',
  heart: '心形鑽 | Heart',
  cushion: '墊形鑽 | Cushion',
  pear: '梨形鑽 | Pear',
  oval: '橢圓鑽 | Oval',
  emerald: '祖母綠形鑽 | Emerald',
  asscher: '阿斯切鑽 | Asscher',
  radiant: '雷迪恩鑽 | Radiant',
  marquise: '馬眼鑽 | Marquise'
};

const productDisplayName = (product: any, fallback: string) =>
  productNameOverrides[product?.slug] ||
  product?.originalDisplayName ||
  (product?.name && product?.englishName && product.name !== product.englishName
    ? `${product.name}｜${product.englishName}`
    : undefined) ||
  product?.englishName ||
  product?.name ||
  fallback;

const productHref = (product: any) => `/products/${product?.routeSlug || product?.slug}/`;

const formatProductPrice = (price: unknown) => {
  if (typeof price === 'number') {
    return `NT$${price.toLocaleString('en-US')}`;
  }

  if (typeof price === 'string' && price.trim()) {
    return price;
  }

  return '';
};

const productDisplayPrice = (product: any) =>
  formatProductPrice(product?.displayPrice) ||
  formatProductPrice(product?.price) ||
  formatProductPrice(product?.salePrice) ||
  formatProductPrice(product?.regularPrice) ||
  formatProductPrice(product?.compareAtPrice) ||
  '歡迎洽詢';
---

<BaseLayout
  title="VELORIA Diamond Symphony"
  description="VELORIA Diamond Symphony 提供求婚鑽戒、結婚對戒、天然鑽石、培育鑽石、彩色鑽石與珠寶訂製服務。"
  canonical={canonical}
  image={heroSlides[0].image}
>
  <section class="home-hero" aria-label="VELORIA首頁主視覺" data-hero-carousel>
    <h1 class="home-hero-title">VELORIA DIAMOND SYMPHONY</h1>
    <div class="hero-canvas image-reveal reveal line-1">
      {heroSlides.map((slide, index) => (
        <figure class:list={['hero-slide', { 'is-active': index === 0 }]} data-hero-slide>
          <img src={slide.image} alt={`${slide.title} - ${slide.eyebrow}`} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
        </figure>
      ))}
    </div>
    <div class="hero-fixed-copy reveal line-2" aria-hidden="true">
      <p class="hero-fixed-kicker">Diamond Symphony</p>
      <p class="hero-fixed-main">Feel the Brilliance</p>
      <p class="hero-fixed-sub">Est. 2026</p>
      <p class="hero-fixed-note">求婚鑽戒｜結婚對戒｜天然鑽石</p>
    </div>
    <div class="hero-overlay reveal line-1">
      {heroSlides.map((slide, index) => (
        <div class:list={['hero-copy', { 'is-active': index === 0 }]} data-hero-copy data-ghost={slide.ghost}>
          <p class="type-section-eyebrow">{slide.eyebrow}</p>
          <h2 class="type-page-title">
            {slide.titleLines.map((line) => <span>{line}</span>)}
          </h2>
          <p class="type-lead">{slide.lead}</p>
          <div class="hero-actions">
            <a
              class="pill-link type-button"
              href={slide.href}
              target={slide.href.startsWith('http') ? '_blank' : undefined}
              rel={slide.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >{slide.cta}</a>
            <a class="text-link type-button" href={site.reservationUrl} target="_blank" rel="noopener noreferrer">預約諮詢</a>
          </div>
        </div>
      ))}
    </div>
    <div class="hero-controls">
      <button class="hero-control hero-control-prev" type="button" aria-label="上一張主視覺" data-hero-prev></button>
      <button class="hero-control hero-control-next" type="button" aria-label="下一張主視覺" data-hero-next></button>
    </div>
    <div class="hero-progress" aria-label="主視覺輪播進度">
      {heroSlides.map((slide, index) => (
        <button class:list={[{ 'is-active': index === 0 }]} type="button" aria-label={`切換到 ${slide.title}`} data-hero-dot></button>
      ))}
    </div>
    <div class="hero-scroll" aria-hidden="true">SCROLL</div>
  </section>

  <section class="hero-news-strip" aria-label="最新消息">
    <button class="hero-news-card reveal line-1" type="button" data-news-open aria-haspopup="dialog">
      <span class="hero-news-kicker">最新消息</span>
      <span class="hero-news-meta">{newsCards[0].date}</span>
      <span class="hero-news-content">
        <strong>{newsCards[0].title}</strong>
        <small>{newsCards[0].description}</small>
      </span>
    </button>
  </section>

  <div class="home-news-modal" data-news-modal role="dialog" aria-modal="true" aria-labelledby="home-news-modal-title" aria-hidden="true">
    <button class="home-news-modal-backdrop" type="button" data-news-close aria-label="關閉最新消息"></button>
    <aside class="home-news-modal-panel" tabindex="-1">
      <button class="home-news-modal-close" type="button" data-news-close aria-label="關閉最新消息"></button>
      <figure class="home-news-modal-figure">
        <img src="/assets/custom-service/veloria-pair-ring-hand-mask.jpg" alt="婚戒配戴示意" loading="eager" decoding="async" />
      </figure>
      <div class="home-news-modal-copy">
        <p class="home-news-modal-label">Latest News</p>
        <h2 id="home-news-modal-title">{newsCards[0].title}</h2>
        <p class="home-news-modal-date">{newsCards[0].date}</p>
        <p>{newsCards[0].description}</p>
        <div class="home-news-modal-actions">
          <a class="home-news-modal-primary" href={newsCards[0].href} target="_blank" rel="noopener noreferrer">預約諮詢</a>
          <a class="home-news-modal-secondary" href="/categories/other-jewelry/pair-rings/">瀏覽婚戒</a>
        </div>
      </div>
    </aside>
    <figure class="home-news-modal-scene" aria-hidden="true">
      <img src="/assets/migrated/banners/home-hero-2.jpeg" alt="" loading="eager" decoding="async" />
    </figure>
  </div>

  <section class="kuno-section about-section" aria-labelledby="about-heading">
    <div class="kuno-container about-layout">
      <div class="about-copy reveal line-2">
        <h2 class="kuno-title" id="about-heading">關於VELORIA</h2>
        <p class="type-body">VELORIA以天然鑽石、彩鑽、婚戒與高級珠寶為核心，從挑選主石、比例設計、戒台工藝到配戴情境，讓每一件作品都能回應配戴者的性格與故事。</p>
        <a class="kuno-link type-button" href="/pages/about-us/">了解品牌</a>
      </div>
    </div>
  </section>

  <section class="kuno-section collection-section is-soft" aria-labelledby="collection-heading">
    <div class="collection-scroll-ring" aria-hidden="true" data-scroll-jewel>
      <img src="/assets/decorations/collection-pink-diamond-ring.png" alt="" loading="lazy" decoding="async" />
    </div>
    <div class="collection-scroll-jewel" aria-hidden="true" data-scroll-jewel>
      <img class="loose-diamond-piece is-round" src="/assets/decorations/loose-diamond-round.png" alt="" loading="lazy" />
      <img class="loose-diamond-piece is-pear" src="/assets/decorations/loose-diamond-pear.png" alt="" loading="lazy" />
      <img class="loose-diamond-piece is-marquise" src="/assets/decorations/loose-diamond-marquise.png" alt="" loading="lazy" />
      <img class="loose-diamond-piece is-emerald" src="/assets/decorations/loose-diamond-emerald.png" alt="" loading="lazy" />
      <img class="loose-diamond-piece is-small" src="/assets/decorations/loose-diamond-round.png" alt="" loading="lazy" />
    </div>
    <div class="kuno-container">
      <div class="kuno-heading reveal line-1">
        <p class="kuno-jp-label">Collection</p>
        <h2 class="kuno-title" id="collection-heading">依照需求瀏覽珠寶系列</h2>
        <p class="kuno-lead">依照求婚、對戒、男士鑽戒、女士鑽戒、時尚珠寶與裸鑽整理入口，讓第一次瀏覽也能快速找到方向。</p>
      </div>
      <div class="collection-grid">
        {categoryCards.map((card, index) => (
          <a class:list={['collection-card', 'reveal', `line-${Math.min(index + 1, 4)}`]} href={card.href} aria-label={`探索${card.label}`}>
            <figure>
              <img class="collection-card-image is-primary" src={card.image} alt={card.label} loading="lazy" />
              <img class="collection-card-image is-hover" src={card.hoverImage} alt="" loading="lazy" />
            </figure>
            <span>
              <strong>{card.label}</strong>
              <small>{card.english}</small>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="brand-marquee" aria-hidden="true">
    <div class="brand-marquee-link">
      <svg class="brand-marquee-svg" viewBox="0 0 1920 230" role="img" aria-labelledby="brand-marquee-title">
        <title id="brand-marquee-title">veloria</title>
        <defs>
          <path id="brand-marquee-path" d="M -300 206 C 36 16, 342 8, 640 106 S 1042 242, 1328 116 S 1718 -18, 2220 132" />
        </defs>
        <text class="brand-marquee-text" xml:space="preserve">
          <textPath href="#brand-marquee-path" startOffset="-26%">
            {brandMarqueeWords.map((word, index) => (
              <>
                <tspan>{word}</tspan>
                {index < brandMarqueeWords.length - 1 && <tspan class="brand-marquee-separator"> ·</tspan>}
              </>
            ))}
            <animate attributeName="startOffset" from="-26%" to="0%" dur="13s" repeatCount="indefinite" />
          </textPath>
        </text>
      </svg>
    </div>
  </div>

  <section class="recommendation-showcase-section" aria-labelledby="recommendations-heading">
    <div class="collection-heading reveal line-1">
      <h2 id="recommendations-heading">Recommendation</h2>
      <p>
        <span>精選推薦</span>
        <span>/</span>
        <a href="/products/">全部商品</a>
      </p>
    </div>

    <div class="collection-stage">
      <div class="collection-container">
        <div class="collection-carousel" data-carousel data-carousel-autoplay="4200">
          <div class="collection-track" data-carousel-track>
            {recommendationProducts.map((product: any, index) => (
              <a class:list={['collection-showcase-card recommendation-showcase-card', 'reveal', `line-${Math.min(index + 1, 4)}`]} href={productHref(product)} aria-label={`查看 ${productDisplayName(product, product.name)}`}>
                <figure>
                  <img src={product.images?.[0]?.src} alt={product.images?.[0]?.alt || productDisplayName(product, product.name)} loading="lazy" decoding="async" />
                </figure>
                <div>
                  <span>RECOMMEND</span>
                  <strong>{productDisplayName(product, product.name)}</strong>
                  <small>{product.displayPrice || '歡迎洽詢'}</small>
                </div>
              </a>
            ))}
          </div>
          <div class="collection-controls">
            <button class="collection-arrow collection-arrow-prev" type="button" aria-label="上一組推薦商品" data-carousel-prev></button>
            <button class="collection-arrow collection-arrow-next" type="button" aria-label="下一組推薦商品" data-carousel-next></button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="concept-offset-section" aria-labelledby="concept-offset-heading">
    <div class="concept-offset-inner">
      <div class="concept-copy reveal line-1">
        <h2 id="concept-offset-heading">Concept Series</h2>
        <p class="concept-subtitle">展現鮮明個性的概念系列</p>
        <p class="kuno-lead">以彩鑽、線條與戒台比例，呈現專屬於每一位配戴者的風格與偏好。</p>
        <figure class="concept-motion">
          <img src="/assets/concept-wall/celestial-bloom.png" alt="彩鑽戒指概念系列" loading="lazy" decoding="async" />
        </figure>
      </div>
      <div class="concept-photo-wall reveal line-2" aria-label="彩鑽概念系列圖片">
        <figure class="concept-photo">
          <img src="/assets/concept-wall/amber-promise-glow-1.png" alt="黃鑽戒指" loading="lazy" decoding="async" />
        </figure>
        <figure class="concept-photo">
          <img src="/assets/concept-wall/blush-halo-promise.png" alt="粉鑽戒指" loading="lazy" decoding="async" />
        </figure>
        <figure class="concept-photo">
          <img src="/assets/concept-wall/ethereal-heart-petals.png" alt="心形彩鑽戒指" loading="lazy" decoding="async" />
        </figure>
        <figure class="concept-photo">
          <img src="/assets/concept-wall/radiant-domain-halo.png" alt="黃鑽光環戒指" loading="lazy" decoding="async" />
        </figure>
      </div>
    </div>
