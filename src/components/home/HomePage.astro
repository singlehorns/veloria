  <section class="kuno-section column-section" aria-labelledby="column-heading">
    <div class="kuno-container column-container">
      <div class="kuno-heading reveal line-1">
        <p class="kuno-jp-label">Column</p>
        <h2 class="kuno-title" id="column-heading">珠寶知識</h2>
        <p class="kuno-lead">以 4C、天然鑽石、保養與客製流程為主題，協助你建立清楚的選購基準。</p>
      </div>

      <div class="editorial-grid">
        {knowledgeCards.map((article, index) => (
          <a class:list={['editorial-card', 'reveal', `line-${Math.min(index + 1, 4)}`]} href={`/blogs/diamond-symphony-guide/${article.slug}/`}>
            <figure>
              <img src={article.data.coverImage} alt={article.data.coverImageAlt || article.data.title} loading="lazy" decoding="async" />
            </figure>
            <div>
              <span class="type-caption">{article.data.category}</span>
              <h3 class={index === 0 ? 'type-card-title-editorial' : 'type-card-title'}>{article.data.title}</h3>
              <p class="type-body-secondary">{article.data.description}</p>
            </div>
          </a>
