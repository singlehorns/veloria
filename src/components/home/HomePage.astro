    background: #f3efea;
    box-shadow: 0 20px 54px rgba(17, 17, 17, 0.1);
  }

  .hero-preview::after {
    content: "NEXT";
    position: absolute;
    right: 0.9rem;
    bottom: 0.85rem;
    color: rgba(255, 255, 255, 0.88);
