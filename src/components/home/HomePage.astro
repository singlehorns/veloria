    letter-spacing: 0.18em;
  }

  .hero-preview img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.05);
    transition:
      opacity 780ms var(--motion-ease-standard),
      transform 1200ms var(--motion-ease-editorial);
  }

  .hero-preview img.is-active {
    opacity: 1;
    transform: scale(1);
  }

  .hero-canvas::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0) 38%),
      linear-gradient(0deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0) 42%);
