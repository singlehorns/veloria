  <section class="home-faq-section" aria-labelledby="home-faq-heading">
    <div class="kuno-container home-faq-inner">
      <div class="kuno-heading home-faq-heading reveal line-1">
        <p class="kuno-jp-label">Ring FAQs</p>
        <h2 class="kuno-title" id="home-faq-heading">常見問題</h2>
      </div>
      <div class="home-faq-list">
        {homeFaqItems.map((item) => (
          <details class="home-faq-item">
            <summary>
              <span class="type-card-title">{item.question}</span>
              <span class="home-faq-icon" aria-hidden="true"></span>
            </summary>
            <p class="type-body-secondary">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const baseRevealNodes = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));
      const textRevealNodes = Array.from(document.querySelectorAll<HTMLElement>(
        '.hero-overlay, .hero-news-card, .kuno-heading, .collection-heading, .concept-copy, .wedding-rings-heading, .service-showcase-copy, .home-faq-heading, .about-copy'
      ));
      const conceptImageRevealNodes = Array.from(document.querySelectorAll<HTMLElement>('.concept-photo-wall .concept-photo'));

      textRevealNodes.forEach((node, index) => {
        if (node.dataset.revealDirection) return;
        const directions = ['reveal-up', 'reveal-left', 'reveal-right'];
        const direction = directions[index % directions.length];
        node.dataset.revealDirection = direction;
        node.classList.add('reveal', 'text-reveal', direction);
      });

      conceptImageRevealNodes.forEach((node) => {
        node.classList.add('concept-image-reveal');
      });

      const motionRevealNodes = Array.from(new Set([...textRevealNodes, ...conceptImageRevealNodes]));
      const revealNodes = Array.from(new Set([...baseRevealNodes, ...motionRevealNodes]));

      const showAllContent = () => {
        revealNodes.forEach((node) => node.classList.add('show'));
      };

      const syncInitialRevealState = () => {
        const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
        motionRevealNodes.forEach((node) => {
          const rect = node.getBoundingClientRect();
          const isVisible = rect.top < viewportHeight * 0.92 && rect.bottom > viewportHeight * 0.08;
          node.classList.toggle('show', isVisible);
        });
      };

      if (prefersReducedMotion || !('IntersectionObserver' in window)) {
        showAllContent();
        return;
      }

      baseRevealNodes.forEach((node) => node.classList.add('show'));

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          entry.target.classList.toggle('show', entry.isIntersecting && entry.intersectionRatio > 0.06);
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: [0, 0.06, 0.16] });

      motionRevealNodes.forEach((node) => {
        observer.observe(node);
      });

      requestAnimationFrame(() => {
        document.body.classList.add('motion-ready');
        syncInitialRevealState();
        document.body.classList.add('text-motion-ready');
      });

      const scrollJewels = Array.from(document.querySelectorAll<HTMLElement>('[data-scroll-jewel]'));
      if (scrollJewels.length) {
        let ticking = false;

        const updateScrollJewels = () => {
          const viewportHeight = window.innerHeight || document.documentElement.clientHeight;

          scrollJewels.forEach((jewel) => {
            const section = jewel.closest<HTMLElement>('section');
            if (!section) return;

            const rect = section.getBoundingClientRect();
            const range = viewportHeight + rect.height;
            const progress = Math.min(1, Math.max(0, (viewportHeight - rect.top) / range));
            jewel.style.setProperty('--scroll-progress', progress.toFixed(3));
          });

          ticking = false;
        };

        const requestScrollJewelUpdate = () => {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(updateScrollJewels);
        };

        window.addEventListener('scroll', requestScrollJewelUpdate, { passive: true });
        window.addEventListener('resize', requestScrollJewelUpdate);
        updateScrollJewels();
      }

      const newsModal = document.querySelector<HTMLElement>('[data-news-modal]');
      const newsOpenButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-news-open]'));
      const newsCloseButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-news-close]'));
      const newsPanel = newsModal?.querySelector<HTMLElement>('.home-news-modal-panel');
      let lastFocusedNewsTrigger: HTMLElement | null = null;
      let newsModalOpenedAtScrollY = window.scrollY;

      const setNewsModalOpen = (open: boolean) => {
        if (!newsModal) return;
        newsModal.classList.toggle('is-open', open);
        newsModal.setAttribute('aria-hidden', String(!open));
        document.documentElement.classList.toggle('has-home-news-modal', open);

        if (open) {
          newsModalOpenedAtScrollY = window.scrollY;
          window.setTimeout(() => newsPanel?.focus(), prefersReducedMotion ? 0 : 180);
          return;
        }

        lastFocusedNewsTrigger?.focus();
      };

      newsOpenButtons.forEach((button) => {
        button.addEventListener('click', () => {
          lastFocusedNewsTrigger = button;
          setNewsModalOpen(true);
        });
      });

      newsCloseButtons.forEach((button) => {
        button.addEventListener('click', () => setNewsModalOpen(false));
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && newsModal?.classList.contains('is-open')) {
          setNewsModalOpen(false);
        }
      });

      window.addEventListener('scroll', () => {
        if (!newsModal?.classList.contains('is-open')) return;
        if (window.scrollY > newsModalOpenedAtScrollY + 12) {
          setNewsModalOpen(false);
        }
      }, { passive: true });

      if (newsModal && !window.sessionStorage.getItem('diamondSymphonyNewsModalClosed')) {
        window.setTimeout(() => {
          setNewsModalOpen(true);
          window.sessionStorage.setItem('diamondSymphonyNewsModalClosed', 'true');
        }, 620);
      }

      document.querySelectorAll<HTMLElement>('[data-hero-carousel]').forEach((hero) => {
        const slides = Array.from(hero.querySelectorAll<HTMLElement>('[data-hero-slide]'));
        const copies = Array.from(hero.querySelectorAll<HTMLElement>('[data-hero-copy]'));
        const dots = Array.from(hero.querySelectorAll<HTMLButtonElement>('[data-hero-dot]'));
        const prev = hero.querySelector<HTMLButtonElement>('[data-hero-prev]');
        const next = hero.querySelector<HTMLButtonElement>('[data-hero-next]');

        if (slides.length <= 1 || !prev || !next) return;

        let activeIndex = 0;
        let autoplayId: number | undefined;
        const shouldAutoplay = false;

        const setHeroSlide = (index: number) => {
          activeIndex = (index + slides.length) % slides.length;

          slides.forEach((slide, slideIndex) => {
            slide.classList.toggle('is-active', slideIndex === activeIndex);
          });

          copies.forEach((copy, copyIndex) => {
            copy.classList.toggle('is-active', copyIndex === activeIndex);
          });

          dots.forEach((dot, dotIndex) => {
            dot.classList.toggle('is-active', dotIndex === activeIndex);
            dot.setAttribute('aria-current', dotIndex === activeIndex ? 'true' : 'false');
          });
        };

        const stopAutoplay = () => {
          if (autoplayId) window.clearInterval(autoplayId);
          autoplayId = undefined;
        };

        const startAutoplay = () => {
          if (!shouldAutoplay || prefersReducedMotion || autoplayId) return;
          autoplayId = window.setInterval(() => setHeroSlide(activeIndex + 1), 5400);
        };

        prev.addEventListener('click', () => {
          stopAutoplay();
          setHeroSlide(activeIndex - 1);
          startAutoplay();
        });

        next.addEventListener('click', () => {
          stopAutoplay();
          setHeroSlide(activeIndex + 1);
          startAutoplay();
        });

        dots.forEach((dot, dotIndex) => {
          dot.addEventListener('click', () => {
            stopAutoplay();
            setHeroSlide(dotIndex);
            startAutoplay();
          });
        });

        hero.addEventListener('pointerenter', stopAutoplay);
        hero.addEventListener('pointerleave', startAutoplay);

        setHeroSlide(0);
        startAutoplay();
      });

      document.querySelectorAll('[data-single-carousel]').forEach((carousel) => {
        const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-single-slide]'));
        const prev = carousel.querySelector<HTMLButtonElement>('[data-single-prev]');
        const next = carousel.querySelector<HTMLButtonElement>('[data-single-next]');

        if (!slides.length || !prev || !next) return;

        let activeIndex = 0;

        const setActiveSlide = (index: number) => {
          activeIndex = (index + slides.length) % slides.length;
          slides.forEach((slide, slideIndex) => {
            slide.classList.toggle('is-active', slideIndex === activeIndex);
          });
          prev.disabled = slides.length <= 1;
          next.disabled = slides.length <= 1;
        };

        prev.addEventListener('click', () => setActiveSlide(activeIndex - 1));
        next.addEventListener('click', () => setActiveSlide(activeIndex + 1));
        setActiveSlide(0);
      });

      document.querySelectorAll('[data-carousel]').forEach((carousel) => {
        const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
        const prev = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
        const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');

        if (!track || !prev || !next) return;
        const items = Array.from(track.children) as HTMLElement[];
        let activeItemIndex = 0;
        let autoplayId: number | undefined;
        const autoplayDelay = Number.parseInt(carousel.getAttribute('data-carousel-autoplay') || '', 10);
        const shouldAutoplay = Number.isFinite(autoplayDelay) && autoplayDelay > 0 && !prefersReducedMotion;

        const getStep = () => {
          const card = items[0];
          if (!card) return track.clientWidth;
          const gap = Number.parseFloat(getComputedStyle(track).columnGap || '0');
          return card.offsetWidth + gap;
        };

        const getItemLeft = (index: number) => {
          const item = items[index];
          return item ? item.offsetLeft - track.offsetLeft : index * getStep();
        };

        const getNearestItemIndex = () => {
          if (!items.length) return 0;
          const scrollLeft = track.scrollLeft;
          return items.reduce((nearestIndex, _item, index) => {
            const currentDistance = Math.abs(getItemLeft(index) - scrollLeft);
            const nearestDistance = Math.abs(getItemLeft(nearestIndex) - scrollLeft);
            return currentDistance < nearestDistance ? index : nearestIndex;
          }, 0);
        };

        const getMaxItemIndex = () => {
          if (!items.length) return 0;
          const maxScrollLeft = Math.max(0, track.scrollWidth - track.clientWidth);
          if (maxScrollLeft <= 1) return 0;
          return items.reduce((nearestIndex, _item, index) => {
            const currentDistance = Math.abs(getItemLeft(index) - maxScrollLeft);
            const nearestDistance = Math.abs(getItemLeft(nearestIndex) - maxScrollLeft);
            return currentDistance < nearestDistance ? index : nearestIndex;
          }, 0);
        };

        const updateControls = () => {
          const step = getStep();
          const maxItemIndex = getMaxItemIndex();
          const canScroll = maxItemIndex > 0;
          activeItemIndex = step > 0 ? Math.min(maxItemIndex, getNearestItemIndex()) : 0;
          carousel.classList.toggle('is-scrollable', canScroll);
          prev.disabled = !canScroll;
          next.disabled = !canScroll;
        };

        const scrollToItem = (index: number) => {
          const maxItemIndex = getMaxItemIndex();
          const itemCount = maxItemIndex + 1;
          const nextIndex = maxItemIndex > 0 ? ((index % itemCount) + itemCount) % itemCount : 0;
          activeItemIndex = nextIndex;
          track.scrollTo({ left: getItemLeft(nextIndex), behavior: prefersReducedMotion ? 'auto' : 'smooth' });
          window.setTimeout(updateControls, prefersReducedMotion ? 0 : 360);
        };

        const stopAutoplay = () => {
          if (autoplayId) window.clearInterval(autoplayId);
          autoplayId = undefined;
        };

        const startAutoplay = () => {
          if (!shouldAutoplay || autoplayId || getMaxItemIndex() <= 0) return;
          autoplayId = window.setInterval(() => {
            const maxItemIndex = getMaxItemIndex();
            scrollToItem(activeItemIndex >= maxItemIndex ? 0 : activeItemIndex + 1);
          }, autoplayDelay);
        };

        const restartAutoplay = () => {
          stopAutoplay();
          startAutoplay();
        };

        prev.addEventListener('click', () => {
          scrollToItem(activeItemIndex - 1);
          restartAutoplay();
        });
        next.addEventListener('click', () => {
          scrollToItem(activeItemIndex + 1);
          restartAutoplay();
        });

        let isDragging = false;
        let didDrag = false;
        let suppressClick = false;
        let hasPointerCapture = false;
        let dragStartX = 0;
        let dragStartScroll = 0;

        track.addEventListener('pointerdown', (event) => {
          if (event.pointerType === 'mouse' && event.button !== 0) return;
          stopAutoplay();
          isDragging = true;
          didDrag = false;
          suppressClick = false;
          hasPointerCapture = false;
          dragStartX = event.clientX;
          dragStartScroll = track.scrollLeft;
        });

        track.addEventListener('pointermove', (event) => {
          if (!isDragging) return;
          const deltaX = event.clientX - dragStartX;
          if (Math.abs(deltaX) > 4) {
            didDrag = true;
            track.classList.add('is-dragging');
            if (!hasPointerCapture) {
              track.setPointerCapture(event.pointerId);
              hasPointerCapture = true;
            }
          }
          track.scrollLeft = dragStartScroll - deltaX;
        });

        const endDrag = (event: PointerEvent) => {
          if (!isDragging) return;
          isDragging = false;
          track.classList.remove('is-dragging');
          if (hasPointerCapture && track.hasPointerCapture(event.pointerId)) {
            track.releasePointerCapture(event.pointerId);
          }
          hasPointerCapture = false;
          suppressClick = didDrag;
          startAutoplay();
        };

        track.addEventListener('pointerup', endDrag);
        track.addEventListener('pointercancel', endDrag);
        track.addEventListener('lostpointercapture', () => {
          isDragging = false;
          didDrag = false;
          suppressClick = false;
          hasPointerCapture = false;
          track.classList.remove('is-dragging');
        });

        track.addEventListener('click', (event) => {
          if (!suppressClick) return;
          event.preventDefault();
          event.stopPropagation();
          didDrag = false;
          suppressClick = false;
        }, true);

        track.addEventListener('scroll', updateControls, { passive: true });
        window.addEventListener('resize', () => {
          updateControls();
          restartAutoplay();
        });
        updateControls();
        startAutoplay();
      });
    });
  </script>
</BaseLayout>

<style>
