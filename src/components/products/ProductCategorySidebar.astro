---
import { directProductLinks, productMenuGroups, standaloneProductLinks } from '@data/productCategories';

interface Props {
  taxonomy?: unknown[];
  activeCategory?: string;
  activeSubcategory?: string;
}

const { activeCategory, activeSubcategory } = Astro.props;
const directOnlySubcategories = new Set(directProductLinks.map((item) => item.slug).filter((slug) => slug !== 'home'));
const activeIsDirectLink = activeSubcategory ? directOnlySubcategories.has(activeSubcategory) : false;
---

<aside class="category-sidebar" aria-label="商品分類選單">
  {directProductLinks.map((item) => (
    <a
      class:list={[
        'menu-row',
        'direct-link',
        { active: item.slug === activeSubcategory || (item.slug === 'home' && !activeCategory && !activeSubcategory) }
      ]}
      href={item.href}
    >
      <span>{item.label}</span>
    </a>
  ))}

  <div class="menu-groups">
    {productMenuGroups.map((group) => {
      const isActive = group.slug === activeCategory;
      const hasActiveChild =
        !activeIsDirectLink &&
        group.slug === activeCategory &&
        group.children.some((child) => child.slug === activeSubcategory);
      return (
        <details class="menu-group" open={(isActive && !activeIsDirectLink) || hasActiveChild}>
          <summary class:list={['menu-row', { active: (isActive && !activeIsDirectLink) || hasActiveChild }]}>
            <a class="summary-link" href={group.href}>{group.label}</a>
            <span class="summary-chevron" aria-hidden="true"></span>
          </summary>
          <div class="submenu">
            {group.children.map((child) => (
              <a
                class:list={{
                  active: !activeIsDirectLink && child.slug === activeSubcategory && group.slug === activeCategory
                }}
                href={child.href}
              >
                {child.label}
              </a>
            ))}
          </div>
        </details>
      );
    })}
  </div>

  {standaloneProductLinks.map((item) => (
    <a class:list={['menu-row', 'direct-link', { active: item.slug === activeCategory }]} href={item.href}>
      <span>{item.label}</span>
    </a>
  ))}
</aside>

<style>
  .category-sidebar {
    position: sticky;
    top: 94px;
    color: var(--color-ink);
  }

  .menu-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 52px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-ink);
    font-size: clamp(1.02rem, 1.05vw, 1.14rem);
    font-weight: 600;
    line-height: 1.3;
  }

  .direct-link:first-child {
    border-top: 0;
  }

  .menu-groups {
    display: grid;
  }

  .menu-group {
    border: 0;
  }

  summary {
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .summary-link {
    color: inherit;
    flex: 1 1 auto;
  }

  .summary-chevron {
    width: 9px;
    height: 9px;
    border-right: 2px solid var(--color-muted);
    border-bottom: 2px solid var(--color-muted);
    transform: rotate(45deg);
    transition: transform 160ms ease;
    flex: 0 0 auto;
  }

  details[open] > summary .summary-chevron {
    transform: rotate(225deg);
  }

  .submenu {
    display: grid;
    padding-left: 0.8rem;
  }

  .submenu a {
    display: flex;
    align-items: center;
    min-height: 48px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    font-weight: 400;
  }

  .active,
  .submenu a.active {
    color: var(--color-deep-blue);
  }

  @media (max-width: 860px) {
    .category-sidebar {
      position: static;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.55rem;
      margin-bottom: 0.15rem;
      padding: 0.1rem 0 0.2rem;
      background: transparent;
      border: 0;
      border-radius: 0;
    }

    .menu-groups {
      display: contents;
    }

    .menu-group {
      flex: 0 0 auto;
    }

    .menu-row {
      flex: 0 0 auto;
      width: auto;
      min-height: 36px;
      gap: 0.4rem;
      padding: 0.45rem 0.82rem;
      border: 1px solid var(--color-border);
      border-radius: 999px;
      background: #fff;
      font-size: 0.88rem;
      font-weight: 600;
      line-height: 1;
      white-space: nowrap;
    }

    .menu-row.active {
      border-color: var(--color-deep-blue);
      background: var(--color-deep-blue);
      color: #fff;
    }

    .summary-link {
      flex: 0 0 auto;
    }

    .summary-chevron {
      display: none;
    }

    .submenu {
      display: none;
    }
  }
</style>
