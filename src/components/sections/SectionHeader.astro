---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<header class="section-header">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {description && <p>{description}</p>}
</header>

<style>
  .section-header {
    max-width: 760px;
    margin-bottom: var(--space-6);
  }

  .section-header h2 {
    margin: 0.35rem 0 0.75rem;
  }
</style>
