      opacity 920ms var(--motion-ease-standard),
      filter 920ms var(--motion-ease-standard);
    will-change: opacity, filter;
  }

  .about-reveal-entrance {
    transition:
      opacity 760ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 920ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 760ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  :global(body.about-motion-ready) .about-reveal {
    opacity: 0;
    filter: none;
    transition-delay: var(--about-reveal-delay, 0ms);
  }

  :global(body.about-motion-ready) .about-reveal-entrance:not([data-about-float]) {
    transform: translate3d(0, 22px, 0);
  }

  :global(body.about-motion-ready) .about-intro-copy.about-reveal-entrance:not(.is-visible) {
    opacity: 0;
    transform: translate3d(0, 22px, 0);
  }

  :global(body.about-motion-ready) .about-reveal-entrance[data-about-reveal-direction="down"] {
    transform: translate3d(0, -42px, 0);
  }

  :global(body.about-motion-ready) .about-reveal-entrance[data-about-reveal-direction="up"] {
    transform: translate3d(0, 42px, 0);
  }

  :global(body.about-motion-ready) .about-reveal-fade {
    filter: blur(8px);
    transition-delay: var(--about-reveal-delay, 0ms);
  }

  .about-reveal.is-visible,
  :global(body.about-motion-ready) .about-reveal.is-visible {
    opacity: 1;
    filter: blur(0);
  }

  :global(body.about-motion-ready) .about-reveal-entrance.is-visible:not([data-about-float]) {
    transform: translate3d(0, 0, 0);
  }

  :global(body.about-motion-ready) .about-reveal-entrance.is-visible[data-about-reveal-direction] {
    transform: translate3d(0, 0, 0);
  }

