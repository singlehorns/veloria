  .about-founder-body p.about-reveal,
  .about-service-item.about-reveal,
  .about-dialogue-quote.about-reveal {
    transition-duration: 1080ms;
  }

  .about-hero-mask.about-reveal,
  .about-service-mask.about-reveal {
