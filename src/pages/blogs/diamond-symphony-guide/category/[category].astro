---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import KnowledgeArticleList from '@components/knowledge/KnowledgeArticleList.astro';
import KnowledgeBreadcrumbs from '@components/knowledge/KnowledgeBreadcrumbs.astro';
import KnowledgeCategoryMobileNav from '@components/knowledge/KnowledgeCategoryMobileNav.astro';
import KnowledgeCategorySidebar from '@components/knowledge/KnowledgeCategorySidebar.astro';
import { knowledgeCategories, knowledgeHome } from '@data/knowledgeCategories';
import { site } from '@data/site';

export async function getStaticPaths() {
  return knowledgeCategories.map((category) => ({ params: { category: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const allArticles = (await getCollection('knowledge'))
  .filter((article) => !article.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const articles = allArticles.filter((article) => article.data.category === category.slug);
const counts = Object.fromEntries(
  knowledgeCategories.map((item) => [
    item.slug,
    allArticles.filter((article) => article.data.category === item.slug).length
  ])
);
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: knowledgeHome.title, item: new URL('/blogs/diamond-symphony-guide/', site.url).toString() },
    { '@type': 'ListItem', position: 3, name: category.name, item: new URL(`/blogs/diamond-symphony-guide/category/${category.slug}/`, site.url).toString() }
  ]
};
---

<BaseLayout title={category.seoTitle} description={category.seoDescription} canonical={`/blogs/diamond-symphony-guide/category/${category.slug}/`}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <div class="breadcrumb-strip">
    <div class="container">
      <KnowledgeBreadcrumbs items={[{ label: '首頁', href: '/' }, { label: '知識專欄', href: '/blogs/diamond-symphony-guide/' }, { label: category.name }]} />
    </div>
  </div>

  <section class="knowledge-archive">
    <div class="knowledge-layout">
      <div class="knowledge-main">
        <KnowledgeCategoryMobileNav activeCategory={category.slug} />
        <div class="category-heading">
          <p>JOURNAL CATEGORY</p>
          <h1>{category.name}</h1>
          <span>{category.description}</span>
        </div>
        <KnowledgeArticleList articles={articles} />
      </div>
      <div class="desktop-sidebar">
        <KnowledgeCategorySidebar activeCategory={category.slug} articles={allArticles} counts={counts} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumb-strip {
    background: #ffffff;
    padding: 0;
  }

  .breadcrumb-strip .container {
    width: min(100% - clamp(32px, 7vw, 128px), 1120px);
    margin-inline: auto;
  }

  .knowledge-archive {
    background: #ffffff;
    padding: clamp(64px, 9vw, 118px) 0 clamp(72px, 9vw, 128px);
  }

  .knowledge-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: clamp(42px, 6vw, 84px);
    align-items: start;
    width: min(100% - clamp(32px, 7vw, 128px), 1120px);
    margin-inline: auto;
  }

  .knowledge-main {
    display: grid;
    gap: clamp(38px, 5vw, 64px);
  }

  .category-heading {
    padding-bottom: clamp(26px, 4vw, 44px);
    border-bottom: 1px solid rgba(183, 155, 112, 0.42);
  }

  .category-heading p {
    margin: 0 0 1rem;
    color: #0a3764;
    font-family: "GFS Didot", Didot, "Times New Roman", serif;
    font-size: 0.78rem;
    letter-spacing: 0.24em;
  }

  .category-heading h1 {
    margin: 0;
    color: #2b2927;
    font-family: "Noto Serif TC", var(--font-serif), serif;
    font-size: clamp(2.2rem, 4.6vw, 4.4rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.18;
  }

  .category-heading span {
    display: block;
    max-width: 660px;
    margin-top: 1.3rem;
    color: rgba(47, 43, 40, 0.68);
    font-size: clamp(0.98rem, 1.1vw, 1.08rem);
    line-height: 2;
  }

  .desktop-sidebar {
    position: sticky;
    top: 96px;
    align-self: start;
  }

  .desktop-sidebar :global(.knowledge-sidebar) {
    position: static;
  }

  @media (max-width: 1023px) {
    .knowledge-layout {
      grid-template-columns: 1fr;
    }

    .desktop-sidebar {
      display: none;
    }
  }
</style>
