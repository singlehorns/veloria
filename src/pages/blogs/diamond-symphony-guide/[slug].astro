---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import KnowledgeBreadcrumbs from '@components/knowledge/KnowledgeBreadcrumbs.astro';
import KnowledgeCategorySidebar from '@components/knowledge/KnowledgeCategorySidebar.astro';
import { getKnowledgeCategory, knowledgeCategories } from '@data/knowledgeCategories';
import { site } from '@data/site';

export async function getStaticPaths() {
  const articles = await getCollection('knowledge');

  return articles
    .filter((article) => !article.data.draft)
    .map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await article.render();
const data = article.data;
const category = getKnowledgeCategory(data.category);
const canonicalPath = `/blogs/diamond-symphony-guide/${article.slug}/`;
const allArticles = (await getCollection('knowledge'))
  .filter((item) => !item.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const counts = Object.fromEntries(
  knowledgeCategories.map((item) => [
    item.slug,
    allArticles.filter((entry) => entry.data.category === item.slug).length
  ])
);
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  image: new URL(data.coverImage, site.url).toString(),
  datePublished: data.publishDate.toISOString(),
  dateModified: (data.updatedDate ?? data.publishDate).toISOString(),
  author: { '@type': 'Organization', name: data.author },
  mainEntityOfPage: new URL(canonicalPath, site.url).toString()
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首頁', item: site.url },
    { '@type': 'ListItem', position: 2, name: '知識專欄', item: new URL('/blogs/diamond-symphony-guide/', site.url).toString() },
    ...(category
      ? [
          {
            '@type': 'ListItem',
            position: 3,
            name: category.name,
            item: new URL(`/blogs/diamond-symphony-guide/category/${category.slug}/`, site.url).toString()
          }
        ]
      : []),
    { '@type': 'ListItem', position: category ? 4 : 3, name: data.title, item: new URL(canonicalPath, site.url).toString() }
  ]
};
---

<BaseLayout title={data.seoTitle ?? data.title} description={data.seoDescription ?? data.description} image={data.coverImage} canonical={canonicalPath}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <section class="section article-section">
    <div class="container article-breadcrumbs">
      <KnowledgeBreadcrumbs
        items={[
          { label: '首頁', href: '/' },
          { label: '知識專欄', href: '/blogs/diamond-symphony-guide/' },
          ...(category ? [{ label: category.name }] : []),
          { label: data.title }
        ]}
      />
    </div>
    <div class="container article-layout">
      <aside class="article-side">
        <div class="article-side-desktop">
          <KnowledgeCategorySidebar activeCategory={data.category} activeArticleSlug={article.slug} articles={allArticles} counts={counts} />
        </div>
        <details class="article-mobile-categories">
          <summary>
            <span>知識分類</span>
            <strong>{category?.name ?? '全部文章'}</strong>
          </summary>
          <KnowledgeCategorySidebar activeCategory={data.category} activeArticleSlug={article.slug} articles={allArticles} counts={counts} />
        </details>
      </aside>
      <div class="article-main">
        <div class="article-content">
          <Content />
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    document.querySelectorAll('.ds-gallery-wrapper').forEach((wrapper) => {
      const hero = wrapper.querySelector(':scope > .ds-hero');
      const header = wrapper.querySelector('.ds-header');
      const intro = wrapper.querySelector('.ds-intro');
      const container = wrapper.querySelector('.ds-container');

      if (!hero || !header || !container || hero.parentElement === container) return;

      container.insertBefore(hero, intro?.nextSibling ?? header.nextSibling);
    });
  </script>
</BaseLayout>

<style is:global>
  .article-section {
    background: #ffffff;
    padding-top: clamp(24px, 3.2vw, 44px);
  }

  .article-breadcrumbs {
    width: min(calc(100% - clamp(32px, 7vw, 128px)), 1120px);
    margin-bottom: clamp(14px, 1.8vw, 24px);
  }

  .article-layout {
    display: grid;
    width: min(calc(100% - clamp(32px, 7vw, 128px)), 1120px);
    grid-template-columns: 250px minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }

  .article-side {
    position: sticky;
    top: 96px;
    display: grid;
    gap: var(--space-6);
    align-self: start;
  }

  .article-side .knowledge-sidebar {
    position: static;
  }

  .article-mobile-categories {
    display: none;
  }

  .article-main {
    display: grid;
    gap: var(--space-7);
    min-width: 0;
  }

  .article-content {
    min-width: 0;
  }

  .ds-gallery-wrapper {
    --ds-gold: var(--color-deep-blue, #0a3764);
    --ds-text: #2c2c2c;
    --ds-light-text: #666666;
    --ds-bg-soft: #fcfaf7;
    --ds-border: rgba(10, 55, 100, 0.18);
    max-width: 100%;
    margin: 0 auto;
    color: var(--ds-text);
    font-family: "PingFang TC", "Noto Sans TC", "Microsoft JhengHei", sans-serif;
    line-height: 1.9;
  }

  .ds-gallery-wrapper h1,
  .ds-gallery-wrapper h2,
  .ds-gallery-wrapper h3 {
    font-family: "Noto Serif TC", "PMingLiU", serif;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .ds-gallery-wrapper p {
    margin: 0 0 1.2rem;
  }

  .ds-container {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(28px, 4.8vw, 52px) clamp(28px, 5.5vw, 54px);
    border: 1px solid rgba(10, 55, 100, 0.18);
    border-radius: 6px;
    background: #ffffff;
  }

  .ds-hero {
    position: relative;
    width: 100%;
    margin: 0 0 3.6rem;
    overflow: hidden;
  }

  .ds-hero img {
    display: block !important;
    width: 100% !important;
    height: 260px !important;
    object-fit: cover !important;
    object-position: center 40% !important;
    opacity: 0;
    filter: blur(12px) brightness(1.05);
    transform: scale(1.05);
    animation: dsHeroReveal 1.6s ease-out forwards;
  }

  .ds-header {
    margin-bottom: 2rem;
    padding: 0 0 1.7rem;
    border-bottom: 1px solid var(--ds-border);
    text-align: left;
  }

  .ds-category {
    display: block;
    margin-bottom: 1rem;
    color: var(--ds-gold);
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .ds-header h1 {
    margin: 0 0 1.5rem;
    font-size: clamp(1.65rem, 2.4vw, 2rem);
    line-height: 1.4;
    opacity: 0;
    transform: translateY(30px);
    animation: dsFadeUpTitle 1.2s ease-out forwards;
    animation-delay: 0.3s;
  }

  .ds-intro {
    margin-bottom: 2.3rem;
    color: var(--ds-light-text);
    font-size: 1rem;
    text-align: justify;
  }

  .ds-content-section {
    margin-bottom: 4rem;
  }

  .ds-content-section h2 {
    display: flex;
    align-items: center;
    margin: 0 0 1.5rem;
    color: var(--ds-text);
    font-size: 1.6rem;
  }

  .ds-content-section h2::before {
    content: "";
    width: 30px;
    height: 1px;
    margin-right: 15px;
    background: var(--ds-gold);
    flex: 0 0 auto;
  }

  .ds-focus-box {
    margin: 3rem 0;
    padding: 2.5rem;
    border-radius: 2px;
    background-color: var(--ds-bg-soft);
    text-align: center;
  }

  .ds-focus-quote {
    display: block;
    margin-bottom: 1rem;
    color: var(--ds-gold);
    font-family: "Noto Serif TC", "PMingLiU", serif;
    font-size: 1.25rem;
  }

  .ds-feature-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin: 3rem 0;
  }

  .ds-feature-item {
    min-width: 200px;
    flex: 1;
    padding-top: 1.5rem;
    border-top: 1px solid var(--ds-border);
  }

  .ds-feature-title {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--ds-gold);
    font-weight: 700;
  }

  .ds-custom-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ds-custom-list li {
    display: flex;
    justify-content: space-between;
    padding: 1rem 0;
    border-bottom: 1px dashed var(--ds-border);
    gap: 1rem;
  }

  .ds-custom-list li b {
    flex-shrink: 0;
    margin-right: 1rem;
    color: var(--ds-gold);
  }

  .ds-summary {
    position: relative;
    margin-top: 5rem;
    padding: 2.5rem;
    border: 1px solid var(--ds-border);
  }

  .ds-summary-label {
    position: absolute;
    top: -12px;
    left: 50%;
    padding: 0 15px;
    background: #fff;
    color: var(--ds-gold);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    transform: translateX(-50%);
  }

  .ds-footer-cta {
    margin-top: 4rem;
    padding: 4rem 0;
    text-align: center;
  }

  .ds-line-btn {
    display: inline-block;
    padding: 12px 40px;
    border: 1px solid var(--ds-gold);
    color: var(--ds-gold);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    transition: all 0.3s;
  }

  .ds-line-btn:hover {
    background: var(--ds-gold);
    color: #fff;
  }

  @keyframes dsHeroReveal {
    0% {
      opacity: 0;
      filter: blur(14px) brightness(1.1);
      transform: scale(1.08);
    }

    60% {
      opacity: 0.7;
      filter: blur(4px);
    }

    100% {
      opacity: 1;
      filter: blur(0);
      transform: scale(1);
    }
  }

  @keyframes dsFadeUpTitle {
    0% {
      opacity: 0;
      transform: translateY(40px);
    }

    60% {
      opacity: 0.7;
      transform: translateY(10px);
    }

    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 900px) {
    .article-layout {
      grid-template-columns: 1fr;
      gap: 1.2rem;
    }

    .article-side {
      position: static;
      display: block;
      order: -1;
    }

    .article-side-desktop {
      display: none;
    }

    .article-mobile-categories {
      display: block;
      border: 1px solid rgba(10, 55, 100, 0.2);
      border-radius: 999px;
      background: #fff;
      overflow: hidden;
    }

    .article-mobile-categories[open] {
      border-radius: 18px;
    }

    .article-mobile-categories summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.9rem;
      min-height: 54px;
      padding: 0 1.1rem;
      color: #0a3764;
      cursor: pointer;
      font-family: var(--font-sans);
      font-weight: 600;
      list-style: none;
    }

    .article-mobile-categories summary::-webkit-details-marker {
      display: none;
    }

    .article-mobile-categories summary::after {
      content: "+";
      flex: 0 0 auto;
      color: rgba(10, 55, 100, 0.72);
      font-size: 1.2rem;
      line-height: 1;
      transition: transform 200ms ease;
    }

    .article-mobile-categories[open] summary::after {
      content: "-";
      transform: rotate(180deg);
    }

    .article-mobile-categories summary span {
      font-size: 1rem;
      letter-spacing: 0.08em;
    }

    .article-mobile-categories summary strong {
      min-width: 0;
      color: rgba(10, 55, 100, 0.58);
      font-size: 0.86rem;
      font-weight: 400;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .article-mobile-categories .knowledge-sidebar {
      border: 0;
      border-top: 1px solid rgba(10, 55, 100, 0.12);
      padding: 1rem 1.1rem 1.2rem;
    }
  }

  @media (max-width: 768px) {
    .ds-hero img {
      height: 180px !important;
    }

  }

  @media (max-width: 600px) {
    .ds-header h1 {
      font-size: 1.6rem;
    }

    .ds-content-section h2 {
      font-size: 1.3rem;
    }

    .ds-custom-list li {
      flex-direction: column;
      gap: 0.4rem;
    }
  }
</style>
